{
  "name": "ai-dnd",
  "version": "0.3.0",
  "private": true,
  "description": "A browser-playable single-player AI-assisted Dungeons & Dragons foundation",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.0"
  }
}
